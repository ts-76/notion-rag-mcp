{
  "name": "notion-rag-mcp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.13",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:secrets": "secretlint \"**/*\"",
    "check": "bun run typecheck && bun run lint:secrets && bun run test",
    "deploy": "wrangler d1 migrations apply NOTION_RAG_DB --remote && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.1.0",
    "@cloudflare/workers-oauth-provider": "^0.8.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "hono": "^4.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@types/node": "^24.0.0",
    "secretlint": "^13.0.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.114.0"
  },
  "cloudflare": {
    "bindings": {
      "NOTION_API_TOKEN": {
        "description": "Create a Notion internal integration and enter its token. Share the required pages and databases with that integration."
      }
    }
  }
}
