{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "notion-rag-mcp",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "NOTION_EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "NOTION_VECTORIZE_DIMENSIONS": "1024",
    "NOTION_VECTORIZE_MONTHLY_UPSERT_DIMENSION_WARNING": "20000000",
    "NOTION_VECTORIZE_MONTHLY_UPSERT_DIMENSION_BUDGET": "24000000"
  },
  "triggers": {
    "crons": ["0 18 */4 * *"]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV"
    }
  ],
  "d1_databases": [
    {
      "binding": "NOTION_RAG_DB",
      "database_name": "notion-rag-mcp",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vectorize": [
    {
      "binding": "NOTION_VECTORIZE",
      "index_name": "notion-rag-mcp"
    }
  ],
  "workflows": [
    {
      "binding": "NOTION_REINDEX_WORKFLOW",
      "name": "notion-rag-mcp-reindex",
      "class_name": "NotionReindexWorkflow"
    },
    {
      "binding": "NOTION_INDEX_WORK_ITEM_WORKFLOW",
      "name": "notion-rag-mcp-index-work-item",
      "class_name": "NotionIndexWorkItemWorkflow"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }

  // Required secrets before deployment:
  //   bunx wrangler secret put NOTION_API_TOKEN
  //   bunx wrangler secret put ACCESS_CLIENT_ID
  //   bunx wrangler secret put ACCESS_CLIENT_SECRET
  //   bunx wrangler secret put ACCESS_TOKEN_URL
  //   bunx wrangler secret put ACCESS_AUTHORIZATION_URL
  //   bunx wrangler secret put ACCESS_JWKS_URL
  //   bunx wrangler secret put COOKIE_ENCRYPTION_KEY
  // Create OAUTH_KV before deployment and add its id to the binding above:
  //   bunx wrangler kv namespace create OAUTH_KV
  // External-link indexing is disabled unless exact trusted hosts are listed in vars:
  //   "NOTION_EXTERNAL_HOST_ALLOWLIST": "docs.example.com,handbook.example.com"
}
